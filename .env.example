# 此文件仅是配置示例。框架不自动加载 .env，请在 shell 中 export。
# 请勿提交真实密钥。

# ---- 模型（必需）----
AGENTLAB_MODEL=deepseek-flash
AGENTLAB_API_KEY=your-api-key
AGENTLAB_BASE_URL=https://api.deepseek.com

# ---- 联网检索（可选）----
# 留空使用免密钥的 DuckDuckGo 后端。
# 可选值：duckduckgo / brave / tavily / searxng
#AGENTLAB_SEARCH_BACKEND=brave
#AGENTLAB_SEARCH_API_KEY=your-search-api-key
#AGENTLAB_SEARX_URL=https://searx.example.com

# ---- 服务端（可选）----
# 仅在本地离线观察框架时开启演示模式，两者需同时设置。
#AGENTLAB_ALLOW_DEMO=1
#AGENTLAB_PROVIDER=demo
